#!/bin/sh
# Boot hook: stop LG telemetry/ad daemons ~60 s after boot (the opt-in groups at once). Disable: touch /media/developer/cleanyourtv/DISABLE-DEBLOAT
[ -e /media/developer/cleanyourtv/DISABLE-DEBLOAT ] && exit 0
[ -e /media/developer/cleanyourtv/DISABLE ] && exit 0   # LG's own Home breaks without the services this blocks
home() { grep -q ' /usr/palm/applications/com.webos.app.home ' /proc/mounts || [ -f /tmp/cleanyourtv-home-standin ]; }
# the opt-in groups (LG's content miner, LG's online servers; debloat-stop.sh does nothing for one that is off): at once, before the
# miner asks LG (about 50 s after the start) and LG Channels starts
(home && sh /media/developer/cleanyourtv/debloat-stop.sh miner lgservers) </dev/null >/dev/null 2>&1 &
(sleep 60; home && sh /media/developer/cleanyourtv/debloat-stop.sh) </dev/null >/dev/null 2>&1 &
