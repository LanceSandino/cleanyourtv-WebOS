#!/bin/sh
# Boot hook: stop LG telemetry/ad daemons ~60 s after boot (LG's content miner at once when that opt-in group is on). Disable: touch /media/developer/cleanyourtv/DISABLE-DEBLOAT
[ -e /media/developer/cleanyourtv/DISABLE-DEBLOAT ] && exit 0
[ -e /media/developer/cleanyourtv/DISABLE ] && exit 0   # LG's own Home breaks without the services this blocks
home() { grep -q ' /usr/palm/applications/com.webos.app.home ' /proc/mounts || [ -f /tmp/cleanyourtv-home-standin ]; }
# LG's content miner (the opt-in group "miner"; debloat-stop.sh does nothing unless it is switched on): at once, before it asks LG
(home && sh /media/developer/cleanyourtv/debloat-stop.sh miner) </dev/null >/dev/null 2>&1 &
(sleep 60; home && sh /media/developer/cleanyourtv/debloat-stop.sh) </dev/null >/dev/null 2>&1 &
