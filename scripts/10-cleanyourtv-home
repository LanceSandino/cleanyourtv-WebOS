#!/bin/sh
# Replace LG's Home with the CleanYourTV launcher (RAM-only; reboot without this script restores stock).
# Use LG's Home instead: the switch in the manager app (creates /media/developer/cleanyourtv/DISABLE and restarts the TV).
# Two ways, chosen by helper/tvprofile.js (homeTakeover) from LG's Home as it came with the TV:
#   mount    (flutter and web Home) the launcher's folder is mounted over LG's Home app and the app manager (sam) is restarted
#   standin  (native Home, webOS 5 to 23) home-standin.sh is mounted over LG's Home program; sam is not restarted.
#            A file home-method holding "mount" in the service folder chooses the first way on such a TV too.
# Run at boot by the Homebrew Channel (no argument); by the setup with "setup" and by an update with "keep". Only at boot does it start
# the debloat early (15-cleanyourtv-debloat early) and start WebAppMgr again without LG's web inspector (devtools-close.sh restart).
export PATH=/usr/bin:/usr/sbin:/bin:/sbin:$PATH
L=/media/developer/cleanyourtv
INITD=/var/lib/webosbrew/init.d
H=/usr/palm/applications/com.webos.app.home
STANDIN=/tmp/cleanyourtv-home-standin   # holds the path of LG's Home program while the stand-in is mounted over it
LOG=/tmp/cleanyourtv-boot.log
up() { cut -d' ' -f1 /proc/uptime; }
replaced() { grep -q " $H " /proc/mounts || { [ -f $STANDIN ] && grep -q " $(cat $STANDIN) " /proc/mounts; }; }
echo "$(up) home: boot script started${1:+ ($1)}" >> $LOG
TAKEOVER=$L/home-takeover   # "<method> <LG's Home program>", worked out at an earlier boot (below)
# Fast start on the native Home (upstream issue 125): until the stand-in is mounted, the Home key opens LG's Home, and the steps before
# the mount start Node.js five times (tvprofile.js, jtool.js, stage-home.sh), which takes seconds while the TV is still booting. At
# boot (no argument), when an earlier boot worked out the way and nothing it depends on changed since (LG's Home as it came,
# tvprofile.js, home-method) and the launcher is staged as it is (no launcher file newer than home-overlay.staged: after an update the
# slow way stages it first; cytv-token.js, which the service writes into both folders at each start, does not count), the stand-in
# is mounted first, before the service starts; the rest follows as before.
FAST=""
if [ -z "$1" ] && [ ! -e $L/DISABLE ] && [ -f $TAKEOVER ] && [ -f $L/wam-launch.json ] && [ -f $L/home-overlay/index.html ] \
  && [ -f $L/home-overlay.staged ] && ! replaced \
  && [ $TAKEOVER -nt $L/backup/home-appinfo.orig.json ] && [ $TAKEOVER -nt $L/tvprofile.js ] \
  && { [ ! -f $L/home-method ] || [ $TAKEOVER -nt $L/home-method ]; } \
  && [ -z "$(find $L/app -type f ! -name cytv-token.js -newer $L/home-overlay.staged 2>/dev/null | head -n 1)" ]; then
  read -r method EXE < $TAKEOVER
  if [ "$method" = standin ] && [ -n "$EXE" ] && [ -f "$EXE" ]; then
    chmod 755 $L/home-standin.sh
    if mount --bind $L/home-standin.sh "$EXE"; then
      echo "$EXE" > $STANDIN
      for p in $(pgrep -f "^$EXE"); do kill "$p" 2>/dev/null; done
      FAST=1
      echo "$(up) home: LG's Home is the program $EXE (known from an earlier boot); the stand-in is mounted over it first" >> $LOG
    fi
  fi
fi
pgrep -f cleanyourtv/helper.js >/dev/null || (nohup node $L/helper.js >/tmp/cleanyourtv-helper.log 2>&1 </dev/null &)
# The watchdog (watchdog.sh, one per boot) starts the service again when it has stopped, also while LG's Home is selected (DISABLE) and
# after an update (the replaced-Home case below leaves this script early), and if our Home stays unreachable for 60 s it falls back to
# stock Home until the next reboot.
pgrep -f "[c]leanyourtv/watchdog.sh" >/dev/null || (sh $L/watchdog.sh </dev/null >/dev/null 2>&1 &)
# LG's web inspector (WebAppMgr's DevTools on port 9998, open to the network): closed unless switched off in the manager. At boot
# WebAppMgr is started again once without it, in the background while Home is staged, and before sam is restarted below; the setup
# and an update only mount the copy of LG's script (it then closes at the next start)
DT=""
# (not after the fast start: a restart of WebAppMgr would close the launcher the stand-in has just opened)
if [ -z "$1" ] && [ -z "$FAST" ]; then
  sh $L/devtools-close.sh restart </dev/null >/dev/null 2>&1 &
  DT=$!
else
  sh $L/devtools-close.sh </dev/null >/dev/null 2>&1
fi
[ -e $L/DISABLE ] && exit 0   # LG's Home is selected: only the service runs (manager, Input key picker)
# the debloat at once (its boot hook, linked while the debloat is on), before Home is taken over: LG's activity manager starts its
# ad and tracking services about ten seconds after this
[ -z "$1" ] && [ -e $INITD/15-cleanyourtv-debloat ] && sh $L/15-cleanyourtv-debloat early
sh $L/stage-home.sh
if [ -z "$FAST" ] && replaced; then
  # already replaced (an update): the served files were refreshed in place; reload Home unless asked not to ($1 = keep)
  [ "$1" = keep ] && exit 0
  sh $L/reload-home.sh
  exit 0
fi

if [ -z "$FAST" ]; then
  method=$(node $L/tvprofile.js get homeTakeover --home "$(node $L/jtool.js kind $L/backup/home-appinfo.orig.json 2>/dev/null)" 2>/dev/null)
  [ "$(cat $L/home-method 2>/dev/null)" = mount ] && method=mount
  EXE=""
  [ "$method" = standin ] && EXE=$(node $L/jtool.js exe $L/backup/home-appinfo.orig.json 2>/dev/null)
  [ "$method" = standin ] && [ -z "$EXE" ] && { echo "$(up) home: LG's Home program not found; using the mount and a sam restart" >> $LOG; method=mount; }
  # for the fast start of the next boot
  [ -n "$method" ] && echo "$method $EXE" > $TAKEOVER
fi
# WebAppMgr's one restart (devtools-close.sh, at most about 20 s) is over before Home is taken over
[ -n "$DT" ] && wait $DT 2>/dev/null

if [ "$method" = standin ]; then
  if [ -z "$FAST" ]; then
    echo "$(up) home: LG's Home is the program $EXE; mounting the stand-in over it (sam is not restarted)" >> $LOG
    chmod 755 $L/home-standin.sh
    mount --bind $L/home-standin.sh "$EXE" || { echo "$(up) home: the mount over $EXE failed" >> $LOG; rm -f $TAKEOVER; exit 1; }
    echo "$EXE" > $STANDIN
    # LG's Home that runs now is its own program: stop it once, sam starts the stand-in for Home from now on
    for p in $(pgrep -f "^$EXE"); do kill "$p" 2>/dev/null; done
  fi
  (
    sleep 3
    fg=$(luna-send -n 1 -w 5000 -f luna://com.webos.applicationManager/getForegroundAppInfo '{}' </dev/null | grep '"appId"')
    # nothing, Home, or the manager app that runs this setup in front: Home is opened, so the new Home can be checked (a setup from
    # the manager used to be undone here: nothing opened Home within the check, seen on a webOS 22 TV)
    case "$fg" in
      *'"appId": ""'*|*com.webos.app.home*|*com.cleanyourtv.manager*|"") luna-send -n 1 -w 10000 -f luna://com.webos.applicationManager/launch '{"id":"com.webos.app.home"}' </dev/null ;;
    esac
    # the launcher must be open in webapp-mgr by now; otherwise LG's Home comes back until the next reboot
    open=0
    for i in $(seq 1 15); do
      luna-send -n 1 -w 3000 luna://com.palm.webappmanager/listRunningApps '{}' </dev/null | grep -q '"com.webos.app.home"' && { open=1; break; }
      sleep 2
    done
    if [ $open = 1 ]; then
      echo "$(up) home: the launcher is open in webapp-mgr" >> $LOG
    else
      echo "$(up) home: the launcher did not open; LG's Home is back until the next reboot" >> $LOG
      sh $L/undo-home.sh temp
    fi
  ) </dev/null >/dev/null 2>&1 &
else
  echo "$(up) home: mounting the launcher over LG's Home, restarting sam" >> $LOG
  mount --bind $L/home-overlay $H && { (sleep 3; pkill -9 -f /usr/palm/applications/airplay/LunaExecutable) </dev/null >/dev/null 2>&1 & systemctl restart sam; }
  echo "$(up) home: sam restarted" >> $LOG
  # After the sam restart nothing is in the foreground (black screen). Once sam is back, start Home again
  # unless the user already went somewhere else (e.g. an HDMI input).
  (
    for i in $(seq 1 60); do systemctl is-active sam >/dev/null && break; sleep 2; done
    sh $L/after-sam.sh   # webOS before 7 and the native Home: the services that keep talking to the old sam (issues 23 and 24)
    sleep 8
    fg=$(luna-send -n 1 -w 5000 -f luna://com.webos.applicationManager/getForegroundAppInfo '{}' </dev/null | grep '"appId"')
    case "$fg" in
      *'"appId": ""'*|*com.webos.app.home*|"")
        pkill -f "[a]pp-id=com.webos.app.home"; sleep 2
        luna-send -n 1 -w 10000 -f luna://com.webos.applicationManager/launch '{"id":"com.webos.app.home"}' </dev/null ;;
    esac
  ) </dev/null >/dev/null 2>&1 &
fi
